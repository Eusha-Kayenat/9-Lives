        if not self.alive:
            return

        self.walk_anim += 0.15
        dx = player_x - self.x
        dz = player_z - self.z
        dist = math.sqrt(dx * dx + dz * dz)

        if dist > 0.1:
            nx = self.x + (dx / dist) * self.speed
            nz = self.z + (dz / dist) * self.speed
            self.x, self.z = resolve_pillar_collisions(nx, nz)
            self.pos[0] = self.x
            self.pos[2] = self.z
            self.yaw = math.degrees(math.atan2(dx, dz))

        if self.hit_flash > 0:
            self.hit_flash -= 1

