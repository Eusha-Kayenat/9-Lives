    # Zombie Minions Spawn & Pursuit AI (Active after Evil Larry's Shield breaks until defeated, max 4 on screen, 20 total)
    global zombie_spawn_cooldown
    if evil_larry_shield_broken and evil_larry_hp > 0 and not is_level_cleared:
        active_zombies = [z for z in zombies if z.alive]
        if len(active_zombies) < MAX_ACTIVE_ZOMBIES and zombies_spawned_count < TOTAL_ZOMBIES_ALLOWED:
            zombie_spawn_cooldown -= 1
            if zombie_spawn_cooldown <= 0:
                spawn_one_zombie()
