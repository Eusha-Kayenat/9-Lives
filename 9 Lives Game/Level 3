# =============================================================================
#  COLLISION DETECTION (Solid Pillars)
# =============================================================================
def resolve_pillar_collisions(nx, nz):
    for k in range(OUTER_COUNT):
        ang = 2 * math.pi * k / OUTER_COUNT
        px = OUTER_RING_R * math.cos(ang)
        pz = OUTER_RING_R * math.sin(ang)

        # 1. Square base plinth collision (half-width 24.8 + player collision radius ~8.2 = 33.0)
        box_half = 33.0
        dx = nx - px
        dz = nz - pz
        if abs(dx) < box_half and abs(dz) < box_half:
            overlap_x = box_half - abs(dx)
            overlap_z = box_half - abs(dz)
            if overlap_x < overlap_z:
                nx = px + math.copysign(box_half, dx if dx != 0.0 else 1.0)
            else:
                nz = pz + math.copysign(box_half, dz if dz != 0.0 else 1.0)

        # 2. Cylindrical body collision
        d = math.sqrt((nx - px)**2 + (nz - pz)**2)
        min_d = OUTER_BASE_R + 12.0
        if d < min_d:
            if d > 0.001:
                nx = px + ((nx - px) / d) * min_d
                nz = pz + ((nz - pz) / d) * min_d
            else:
                nx += 1.0

    if not small_pillars_destroyed:
        for k in range(INNER_COUNT):
            ang = 2 * math.pi * k / INNER_COUNT
            px = INNER_RING_R * math.cos(ang)
            pz = INNER_RING_R * math.sin(ang)
            d = math.sqrt((nx - px)**2 + (nz - pz)**2)
            min_d = INNER_BASE_R + 10.0
            if d < min_d:
                if d > 0.001:
                    nx = px + ((nx - px) / d) * min_d
                    nz = pz + ((nz - pz) / d) * min_d
                else:
                    nx += 1.0

    return nx, nz

