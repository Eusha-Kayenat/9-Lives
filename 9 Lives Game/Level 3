        for i in range(segs):
            a1 = 2 * math.pi * i / segs
            a2 = 2 * math.pi * (i + 1) / segs
            glVertex3f(pounce_target[0] + math.cos(a1) * pounce_shockwave_r, 0.8, pounce_target[1] + math.sin(a1) * pounce_shockwave_r)
