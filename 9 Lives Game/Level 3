    # Small Larry Spawn & AI Logic
    if not evil_larry_shield_broken:
        while len([sl for sl in small_larrys if sl.alive]) < MAX_ACTIVE_SMALL_LARRY and small_larrys_spawned_count < TOTAL_SMALL_LARRY_ALLOWED:
