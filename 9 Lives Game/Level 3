def spawn_one_small_larry():
    global small_larrys_spawned_count
    if small_larrys_spawned_count >= TOTAL_SMALL_LARRY_ALLOWED or evil_larry_shield_broken:
        return
    angle = random.uniform(0, 2*math.pi)
    dist  = random.uniform(140.0, 460.0)
    sx = math.cos(angle) * dist
    sz = math.sin(angle) * dist
    small_larrys.append(SmallLarry(sx, sz))
    small_larrys_spawned_count += 1

def spawn_one_zombie():
    """Spawns one Zombie when Evil Larry's shield is broken (max 4 active, max 20 total)."""
    global zombies_spawned_count
    if not evil_larry_shield_broken or evil_larry_hp <= 0 or is_level_cleared:
        return
    if zombies_spawned_count >= TOTAL_ZOMBIES_ALLOWED:
        return
    angle = random.uniform(0, 2 * math.pi)
    dist = random.uniform(180.0, 440.0)
    zx = math.cos(angle) * dist
    zz = math.sin(angle) * dist
    # Maintain safe initial distance from player on spawn
    if math.sqrt((zx - player_pos[0])**2 + (zz - player_pos[2])**2) < 90.0:
        zx = -zx
        zz = -zz
    zx, zz = resolve_pillar_collisions(zx, zz)
    zombies.append(Zombie(zx, zz))
    zombies_spawned_count += 1
    explosions.append(Explosion(zx, 8.0, zz, max_r=18.0))

def fire_weapon():
    global weapon_cooldown, arm_throw_timer

    if weapon_cooldown > 0 or is_game_over or is_level_cleared or is_paused:
        return

    weapon_cooldown = WEAPON_COOLDOWN_MAX
    arm_throw_timer = 18

    # Smooth full-range pitch clamp identical to Level 2
    pitch_val = player_pitch if first_person else -player_pitch
    clamped_pitch = max(-15.0, min(50.0, pitch_val))
    rad = math.radians(camera_yaw if first_person else player_yaw)
    rad_pitch = math.radians(clamped_pitch)

    # Launch directly along player/camera forward direction (matching Level 2 aiming precision)
    bx = player_pos[0] + math.sin(rad) * 8.0
    by = player_pos[1] + 16.0
    bz = player_pos[2] + math.cos(rad) * 8.0

    throw_speed = 4.4
    vx = math.sin(rad) * math.cos(rad_pitch) * throw_speed
    vy = math.sin(rad_pitch) * throw_speed + 0.85
    vz = math.cos(rad) * math.cos(rad_pitch) * throw_speed

    if active_weapon == "gun":
        bombs.append(Bomb(bx, by, bz, vx, vy, vz))
    else:
        catnips.append(CatnipProjectile(bx, by, bz, vx, vy, vz))

