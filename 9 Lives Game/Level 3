def draw_pounce_effects():
    if pounce_state in ['WINDUP', 'AIR']:
        tx, tz = pounce_target[0], pounce_target[1]
        t = time.time()
        pulse = 0.5 + 0.5 * math.sin(t * 14.0)
        warning_y = 1.4  # Float clearly above ground to prevent z-fighting

        # 1. Glowing Floor Hazard Disc (Alternating high-contrast hazard sectors)
        glBegin(GL_TRIANGLES)
        segs = 32
        disc_r = 38.0
        for i in range(segs):
            a1 = 2 * math.pi * i / segs
            a2 = 2 * math.pi * (i + 1) / segs
            if i % 2 == 0:
                glColor3f(0.85 + 0.15 * pulse, 0.25 * pulse, 0.05)
            else:
                glColor3f(0.40 + 0.20 * pulse, 0.05, 0.02)
            glVertex3f(tx, warning_y, tz)
            glVertex3f(tx + math.cos(a1) * disc_r, warning_y, tz + math.sin(a1) * disc_r)
            glVertex3f(tx + math.cos(a2) * disc_r, warning_y, tz + math.sin(a2) * disc_r)
        glEnd()

        # 2. Concentric Warning Rings (Bold Multi-Layer Perimeter & Internal Rings)
        glBegin(GL_LINES)
        # Bold Outer Perimeter (radius 38.0, 3 concentric lines for thickness)
        for dr in (-1.0, 0.0, 1.0):
            r = 38.0 + dr
            for i in range(segs):
                a1 = 2 * math.pi * i / segs
                a2 = 2 * math.pi * (i + 1) / segs
                glColor3f(1.0, 0.95, 0.15)  # Blazing golden warning border
                glVertex3f(tx + math.cos(a1) * r, warning_y + 0.1, tz + math.sin(a1) * r)
                glVertex3f(tx + math.cos(a2) * r, warning_y + 0.1, tz + math.sin(a2) * r)

        # Mid Danger Ring (radius 24.0)
        for i in range(segs):
            a1 = 2 * math.pi * i / segs
            a2 = 2 * math.pi * (i + 1) / segs
            glColor3f(1.0, 0.45 + 0.35 * pulse, 0.05)
            glVertex3f(tx + math.cos(a1) * 24.0, warning_y + 0.1, tz + math.sin(a1) * 24.0)
            glVertex3f(tx + math.cos(a2) * 24.0, warning_y + 0.1, tz + math.sin(a2) * 24.0)

        # Core Bullseye Ring (radius 10.0)
        for i in range(segs):
            a1 = 2 * math.pi * i / segs
            a2 = 2 * math.pi * (i + 1) / segs
            glColor3f(1.0, 0.1, 0.1)
            glVertex3f(tx + math.cos(a1) * 10.0, warning_y + 0.1, tz + math.sin(a1) * 10.0)
            glVertex3f(tx + math.cos(a2) * 10.0, warning_y + 0.1, tz + math.sin(a2) * 10.0)

        # Expanding Ripple Wave from center
        wave_r = (t * 50.0) % 38.0
        wave_fade = 1.0 - (wave_r / 38.0)
        glColor3f(1.0 * wave_fade, 0.9 * wave_fade, 0.2 * wave_fade)
        for i in range(segs):
            a1 = 2 * math.pi * i / segs
            a2 = 2 * math.pi * (i + 1) / segs
            glVertex3f(tx + math.cos(a1) * wave_r, warning_y + 0.15, tz + math.sin(a1) * wave_r)
            glVertex3f(tx + math.cos(a2) * wave_r, warning_y + 0.15, tz + math.sin(a2) * wave_r)

        # 3. Dynamic Crosshairs & Hazard Spoke Markers
        glColor3f(1.0, 0.95, 0.2)
        # Cardinal X axis & Z axis lines
        glVertex3f(tx - 38.0, warning_y + 0.15, tz); glVertex3f(tx + 38.0, warning_y + 0.15, tz)
        glVertex3f(tx, warning_y + 0.15, tz - 38.0); glVertex3f(tx, warning_y + 0.15, tz + 38.0)
        # Tick marks along axes
        for dist_mark in (-24.0, -10.0, 10.0, 24.0):
            glVertex3f(tx + dist_mark, warning_y + 0.15, tz - 3.5); glVertex3f(tx + dist_mark, warning_y + 0.15, tz + 3.5)
            glVertex3f(tx - 3.5, warning_y + 0.15, tz + dist_mark); glVertex3f(tx + 3.5, warning_y + 0.15, tz + dist_mark)

        # Rotating Hazard Diagonal Cross
        rot = t * 2.2
        for rot_offset in (0, math.pi / 2.0):
            ra = rot + rot_offset
            dx = math.cos(ra) * 32.0
            dz = math.sin(ra) * 32.0
            glColor3f(1.0, 0.3 * pulse, 0.05)
            glVertex3f(tx - dx, warning_y + 0.15, tz - dz)
            glVertex3f(tx + dx, warning_y + 0.15, tz + dz)

        # 4. Vertical Beacon Guidance Beacons (Orbital Danger Telegraph Pillars)
        # Center high beacon
        glColor3f(1.0, 0.9, 0.2)
        glVertex3f(tx, warning_y, tz); glVertex3f(tx, warning_y + 55.0, tz)
        # 8 Perimeter Beams
        beam_h = 28.0 + 8.0 * pulse
        for k in range(8):
            ba = 2 * math.pi * k / 8
            bx = tx + math.cos(ba) * 38.0
            bz = tz + math.sin(ba) * 38.0
            glColor3f(1.0, 0.5 + 0.5 * pulse, 0.1)
            glVertex3f(bx, warning_y, bz); glVertex3f(bx, warning_y + beam_h, bz)
        glEnd()

    if pounce_shockwave_life > 0:
        fade = pounce_shockwave_life / 25.0
        glBegin(GL_LINES)
        glColor3f(1.0 * fade, 0.6 * fade, 0.1 * fade)
