# -----------------------------------------------------------------------------
def idle():
    """
    Main Animation & Physics loop called continuously by GLUT.
    """
    global player_pos, is_jumping, y_velocity, gun_rotation_angle, catnip_rotation_angle
    global gun_picked_up, catnip_picked_up, fire_cooldown, zombie_spawn_timer
    global player_hp, player_invulnerable_timer, is_game_over

    if is_paused or is_game_over:
        glutPostRedisplay()
        return

    # 1. Update Gun & Catnip Rotations
    gun_rotation_angle = (gun_rotation_angle + 2.5) % 360.0
    catnip_rotation_angle = (catnip_rotation_angle + 3.0) % 360.0

    # 2. Check Gun Pickup Collision
    if not gun_picked_up:
        dist_to_gun = math.sqrt((player_pos[0] - gun_pickup_pos[0])**2 + (player_pos[2] - gun_pickup_pos[2])**2)
        if dist_to_gun < 2.2:
            gun_picked_up = True
            print(">> Grenade Launcher Acquired! Aim at any zombie to Launch Slow Projectile Nades!")

    # 3. Check Catnip Pickup Collision (after all zombies defeated)
    if catnip_spawned and not catnip_picked_up:
        dist_to_catnip = math.sqrt((player_pos[0] - catnip_pickup_pos[0])**2 + (player_pos[2] - catnip_pickup_pos[2])**2)
        if dist_to_catnip < 2.2:
            catnip_picked_up = True
            print(">> Glowing Blue Catnip Acquired! Press 'F' to switch between Gun & Catnip!")

    # 4. Update Player Jumping Physics
    if is_jumping:
        player_pos[1] += y_velocity
        y_velocity += gravity
        if player_pos[1] <= ground_y:
            player_pos[1] = ground_y
            is_jumping = False
            y_velocity = 0.0

    # 5. Update Weapon Cooldown
    if fire_cooldown > 0:
        fire_cooldown -= 1

    # 6. Check Auto-Aim / Look-at Shooting (With Line of Sight check)
    check_auto_target_and_shoot()

    # 7. Update Flying Grenades / Catnip Projectiles & Crate Blast Blocking
    update_grenades_and_explosions()

    # 8. Zombie Spawning System (Max 10 total)
    if zombies_spawned < TOTAL_ZOMBIES_COUNT:
        zombie_spawn_timer += 1
        if zombie_spawn_timer >= ZOMBIE_SPAWN_INTERVAL:
            zombie_spawn_timer = 0
            spawn_zombie()

    # 9. Update Zombies & Player Hit Detection
    if player_invulnerable_timer > 0:
        player_invulnerable_timer -= 1

    for z in zombies:
        z.update()
        # Collision with player
        dist_to_player = math.sqrt((z.pos[0] - player_pos[0])**2 + (z.pos[2] - player_pos[2])**2)
        if dist_to_player < 1.5 and player_invulnerable_timer <= 0:
            if not cheat_mode:  # Protected by Cheat Mode
                player_hp = max(0, player_hp - 15)
                player_invulnerable_timer = 50
                print(f">> Player hit by Zombie! HP: {player_hp}/{player_max_hp}")
                if player_hp <= 0:
                    is_game_over = True
                    print(">> Health depleted! Press R to Restart.")
            else:
                player_invulnerable_timer = 30  # No damage in cheat mode

    glutPostRedisplay()

