def mouse_motion_handler(x, y):
    """
    Handles camera rotation when Left Mouse Button (LMB) is held down and dragged,
    exactly like Arena 3!
    """
    global player_yaw, player_pitch, last_x, last_y

    if mouse_down:
        dx = x - last_x
        dy = y - last_y

        player_yaw = (player_yaw - dx * 0.45) % 360.0
        player_pitch = max(-45.0, min(60.0, player_pitch - dy * 0.35))

        last_x, last_y = x, y
        glutPostRedisplay()

def mouse_listener(button, state, x, y):
    """
    Handles mouse button events:
    - LMB Hold & Drag: Controls Camera Look Direction (Arena 3 style)
    - RMB Click: Toggles Camera View (1st Person POV <-> 3rd Person Follow)
    """
    global mouse_down, last_x, last_y, first_person

    if button == GLUT_LEFT_BUTTON:
        if state == GLUT_DOWN:
            mouse_down = True
            last_x, last_y = x, y
        elif state == GLUT_UP:
            mouse_down = False

    elif button == GLUT_RIGHT_BUTTON:
        if state == GLUT_DOWN:
            first_person = not first_person
            glutPostRedisplay()

def keyboard_listener(key, x, y):
    """
    Handles standard ASCII keys: WASD, Space, C (Cheat Mode), F (Switch Weapon), V, P, R, ESC.
    """
    global player_pos, is_jumping, y_velocity
    global first_person, is_paused, is_game_over, cheat_mode, active_weapon

    try:
        ch = key.decode('utf-8').lower()
    except:
        ch = str(key).lower()

    rad = math.radians(player_yaw)

    if not is_paused and not is_game_over:
        # Move Forward (W)
        next_x = player_pos[0]
        next_z = player_pos[2]

        if ch == 'w':
            next_x += math.sin(rad) * player_speed
            next_z += math.cos(rad) * player_speed
        # Move Backward (S)
        elif ch == 's':
            next_x -= math.sin(rad) * player_speed
            next_z -= math.cos(rad) * player_speed
        # Strafe Left (A)
        elif ch == 'a':
            next_x += math.sin(rad + math.pi / 2.0) * player_speed
            next_z += math.cos(rad + math.pi / 2.0) * player_speed
        # Strafe Right (D)
        elif ch == 'd':
            next_x += math.sin(rad - math.pi / 2.0) * player_speed
            next_z += math.cos(rad - math.pi / 2.0) * player_speed

        # Prevent player from walking through crates (Slide around crate obstacles)
        curr_y = player_pos[1]
        res_x, res_z = resolve_entity_crate_collision(next_x, next_z, radius=0.9, y_height=curr_y)
        player_pos[0] = res_x
        player_pos[2] = res_z

        # Jump (Spacebar)
        if ch == ' ' or key == b' ':
            if not is_jumping:
                is_jumping = True
                y_velocity = jump_strength
        # Cheat Mode Toggle (C)
        elif ch == 'c':
            cheat_mode = not cheat_mode
            if cheat_mode:
                player_hp = player_max_hp
                print(">> [CHEAT MODE ENABLED]: Unlimited Health & Invulnerability ON!")
            else:
                print(">> [CHEAT MODE DISABLED]: Normal Damage Restored.")
        # Switch Active Weapon (F): Gun <-> Catnip
        elif ch == 'f':
            if catnip_picked_up:
                active_weapon = "catnip" if active_weapon == "gun" else "gun"
                print(f">> Active Weapon Switched to: {active_weapon.upper()}")
            else:
                launch_projectile()
        # Toggle Camera View (V): 1st Person <-> 3rd Person Follow (identical to Right Click)
        elif ch == 'v':
            first_person = not first_person

    # Pause Toggle (P)
    if ch == 'p':
        is_paused = not is_paused

    # Reset Arena (R)
    elif ch == 'r':
        reset_arena()

    # ESC to Exit
    elif key == b'\x1b':
        sys.exit(0)

    # Restrict player within arena boundaries
    limit = ARENA_SIZE - 1.8
    player_pos[0] = max(-limit, min(limit, player_pos[0]))
    player_pos[2] = max(-limit, min(limit, player_pos[2]))

    glutPostRedisplay()

def special_key_listener(key, x, y):
    """
    Handles 'CTRL' button (Left Ctrl / Right Ctrl) for crouching (Arena 1).
    """
    global crouching

    # Keycodes 114 (GLUT_KEY_CTRL_L) & 115 (GLUT_KEY_CTRL_R) for Crouch
    if key == 114 or key == 115:
