class Zombie:
    def __init__(self, x, z):
        self.pos = [x, 0.0, z]
        self.is_hit_orange = False
        self.death_timer = 0
        self.speed = zombie_base_speed + random.uniform(-0.003, 0.003)
        self.yaw = 0.0
        self.walk_anim = random.uniform(0, 10)

    def update(self):
        self.walk_anim += 0.04

        # Move slowly towards player
        dx = player_pos[0] - self.pos[0]
        dz = player_pos[2] - self.pos[2]
        dist = math.sqrt(dx * dx + dz * dz)

        if dist > 0.6:
            step_x = (dx / dist) * self.speed
            step_z = (dz / dist) * self.speed

            # Candidate next position
            next_x = self.pos[0] + step_x
            next_z = self.pos[2] + step_z

            # Resolve crate obstacle collision (Zombie cannot walk through crates)
            res_x, res_z = resolve_entity_crate_collision(next_x, next_z, radius=0.8, y_height=0.5)

            self.pos[0] = res_x
            self.pos[2] = res_z

            # Face movement direction
            move_dx = res_x - self.pos[0]
            move_dz = res_z - self.pos[2]
            if move_dx * move_dx + move_dz * move_dz > 1e-6:
                self.yaw = math.degrees(math.atan2(move_dx, move_dz))
            else:
                self.yaw = math.degrees(math.atan2(dx, dz))

        # Keep within arena bounds
        limit = ARENA_SIZE - 2.0
        self.pos[0] = max(-limit, min(limit, self.pos[0]))
        self.pos[2] = max(-limit, min(limit, self.pos[2]))

    def draw(self):
        glPushMatrix()
        glTranslatef(self.pos[0], self.pos[1], self.pos[2])
        glRotatef(self.yaw, 0, 1, 0)

        # Align model coordinates to world space
        glRotatef(-90, 1, 0, 0)
        glRotatef(180, 0, 0, 1)

        scale_factor = 0.008
        glScalef(scale_factor, scale_factor, scale_factor)

        # Draw the zombie mesh (turns orange if hit)
        draw_zombie_mesh(is_orange=self.is_hit_orange)

        glPopMatrix()

def spawn_zombie():
    """
    Spawns a zombie at a random perimeter edge up to the total round limit of 10.
    """
    global zombies_spawned

    if zombies_spawned >= TOTAL_ZOMBIES_COUNT:
        return
    if len(zombies) >= MAX_ACTIVE_ZOMBIES:
        return

    side = random.randint(0, 3)
    spawn_offset = ARENA_SIZE - 4.0
    if side == 0:  # North
        x = random.uniform(-spawn_offset, spawn_offset)
        z = spawn_offset
    elif side == 1:  # South
        x = random.uniform(-spawn_offset, spawn_offset)
        z = -spawn_offset
    elif side == 2:  # West
        x = -spawn_offset
        z = random.uniform(-spawn_offset, spawn_offset)
    else:  # East
        x = spawn_offset
        z = random.uniform(-spawn_offset, spawn_offset)

    zombies.append(Zombie(x, z))
    zombies_spawned += 1

# -----------------------------------------------------------------------------
# Slow Projectiles (Grenade / Catnip) & Red Glow Death Effects
# -----------------------------------------------------------------------------
def check_auto_target_and_shoot():
    """
    Calculates if the player's view vector is pointed at any active zombie.
    If aiming at an UNOBSTRUCTED zombie (not behind crates), launches weapon automatically!
    """
    global is_target_locked

    if (not gun_picked_up and not catnip_picked_up) or is_paused or is_game_over or is_level_cleared:
        is_target_locked = False
        return

    rad_yaw = math.radians(player_yaw)
    rad_pitch = math.radians(player_pitch)

    # Player look direction unit vector
    dir_x = math.sin(rad_yaw) * math.cos(rad_pitch)
    dir_y = math.sin(rad_pitch)
    dir_z = math.cos(rad_yaw) * math.cos(rad_pitch)

    eye_y = player_pos[1] + (0.8 if crouching else eye_height)

    locked = False
    for z in zombies:
        # Check Line of Sight: Cannot see or shoot through crates!
        if not is_line_of_sight_clear(player_pos[0], player_pos[2], z.pos[0], z.pos[2]):
            continue  # Blocked by solid wooden crate

        vx = z.pos[0] - player_pos[0]
        vy = (z.pos[1] + 1.2) - eye_y
        vz = z.pos[2] - player_pos[2]
        dist = math.sqrt(vx * vx + vy * vy + vz * vz)

        if dist > 0.5 and dist < 80.0:
            ux, uy, uz = vx / dist, vy / dist, vz / dist
            dot = dir_x * ux + dir_y * uy + dir_z * uz

            # Threshold for aiming at zombie (~20 degree cone)
            if dot > 0.93:
                locked = True
                if fire_cooldown <= 0:
                    launch_projectile()
                break

    is_target_locked = locked

def launch_projectile():
    """
    Fires a slow-motion, arced projectile grenade or catnip based on active_weapon.
    """
    global fire_cooldown

    if active_weapon == "gun" and not gun_picked_up:
        return
    if active_weapon == "catnip" and not catnip_picked_up:
        return
    if fire_cooldown > 0:
        return

    fire_cooldown = 22  # Deliberate launch rate

    rad_yaw = math.radians(player_yaw)
    rad_pitch = math.radians(player_pitch)

    # Calculate velocity with upward toss arc (slowed down for clear visual tracking)
    vx = math.sin(rad_yaw) * math.cos(rad_pitch) * GRENADE_SPEED
    vy = math.sin(rad_pitch) * GRENADE_SPEED + 0.08  # Upward launch arc
    vz = math.cos(rad_yaw) * math.cos(rad_pitch) * GRENADE_SPEED

    start_x = player_pos[0] + math.sin(rad_yaw) * 0.8
    start_y = player_pos[1] + (0.8 if crouching else 1.3)
    start_z = player_pos[2] + math.cos(rad_yaw) * 0.8

    grenades.append({
        'pos': [start_x, start_y, start_z],
        'vel': [vx, vy, vz],
        'rot': 0.0,
        'is_catnip': (active_weapon == "catnip"),
        'life': GRENADE_MAX_LIFE
    })

def update_grenades_and_explosions():
    """
    Updates projectile trajectory slowly with gravity, detects collision with crates/zombies/ground,
    turns zombies orange on hit, triggers one-shot defeat, and spawns red glow effects.
    """
    global score, zombies_killed, is_level_cleared, catnip_spawned

    for g in grenades[:]:
        # Move along velocity
        g['pos'][0] += g['vel'][0]
        g['pos'][1] += g['vel'][1]
        g['pos'][2] += g['vel'][2]

        # Apply gravity drop
        g['vel'][1] += GRENADE_GRAVITY
        g['rot'] = (g['rot'] + 8.0) % 360.0
        g['life'] -= 1

        gx, gy, gz = g['pos']

        # Check boundary collision or floor impact
        hit_ground = (gy <= 0.2)
        out_of_bounds = (abs(gx) >= ARENA_SIZE or abs(gz) >= ARENA_SIZE)

        # Check collision with solid wooden crates (Cannot shoot through crates)
        hit_crate = False
        for c in CRATE_BOXES:
            if c['min_x'] <= gx <= c['max_x'] and c['min_y'] <= gy <= c['max_y'] and c['min_z'] <= gz <= c['max_z']:
                hit_crate = True
                break

        # Check direct zombie collision
        hit_zombie_target = None
        for z in zombies:
            dist_sq = (gx - z.pos[0])**2 + (gy - (z.pos[1] + 1.0))**2 + (gz - z.pos[2])**2
            if dist_sq < 2.5:
                hit_zombie_target = z
                break

        # Explode if hit zombie, hit crate, hit floor, or timed out
        if hit_zombie_target or hit_crate or hit_ground or out_of_bounds or g['life'] <= 0:
            if g in grenades:
                grenades.remove(g)

            # Damage zombies within blast radius only if Line of Sight is unobstructed by crates!
            for z in zombies[:]:
                dist_blast = math.sqrt((gx - z.pos[0])**2 + (gy - z.pos[1])**2 + (gz - z.pos[2])**2)
                if dist_blast <= 4.0 or z == hit_zombie_target:
                    # Verify blast LOS (Crate blocks blast penetration)
                    if z == hit_zombie_target or is_line_of_sight_clear(gx, gz, z.pos[0], z.pos[2]):
                        # 1. Zombie turns Orange on hit
                        z.is_hit_orange = True

                        # 2. Spawns Red Glow death aura at zombie kill location
                        death_effects.append({
                            'pos': [z.pos[0], 0.1, z.pos[2]],
                            'timer': 60,
                            'max_timer': 60
                        })

                        # 3. One-Shot Kill: Remove zombie immediately
                        if z in zombies:
                            zombies.remove(z)
                            score += 100
                            zombies_killed += 1

                            # When all 10 zombies are defeated -> Spawn glowing blue Catnip!
                            if zombies_killed >= TOTAL_ZOMBIES_COUNT:
                                is_level_cleared = True
                                catnip_spawned = True
                                print(">> ALL 10 ZOMBIES DEFEATED! A Glowing Blue Catnip has spawned on the ground!")

    # Update lingering Red Glow death effects
    for d in death_effects[:]:
        d['timer'] -= 1
        if d['timer'] <= 0:
            death_effects.remove(d)

def draw_grenades():
    """
    Renders 3D slow-moving spinning projectile grenades or glowing catnip.
    """
    for g in grenades:
        gx, gy, gz = g['pos']
        glPushMatrix()
        glTranslatef(gx, gy, gz)
        glRotatef(g['rot'], 1, 1, 0)

        if g.get('is_catnip', False):
            # Glowing Blue Catnip Projectile
            draw_box(0.35, 0.35, 0.35, color_top=COLOR_CATNIP_BLUE, color_side=COLOR_CATNIP_AURA)
        else:
            # Slow Grenade Body
            draw_box(0.35, 0.35, 0.35, color_top=COLOR_GRENADE, color_side=(0.12, 0.28, 0.14))
            glTranslatef(0.0, 0.22, 0.0)
            draw_box(0.14, 0.14, 0.14, color_top=COLOR_GRENADE_FUSE, color_side=COLOR_GRENADE_FUSE)

        glPopMatrix()

def draw_red_glow_death_effects():
    """
    Renders an expanding, lingering Red Glow / Death Aura at the location of each defeated zombie.
    """
    for d in death_effects:
        dx, dy, dz = d['pos']
        progress = 1.0 - (d['timer'] / float(d['max_timer']))  # 0.0 to 1.0
        current_radius = 1.0 + progress * 3.5
        alpha_intensity = max(0.2, 1.0 - progress)

        # 1. Pulsating Red Expanding Ring on Floor
        glColor3f(1.0 * alpha_intensity, 0.1 * alpha_intensity, 0.1 * alpha_intensity)
        glLineWidth(3.5)
        glBegin(GL_LINES)
        segs = 28
        for i in range(segs):
            t1 = 2.0 * math.pi * i / segs
            t2 = 2.0 * math.pi * (i + 1) / segs
            glVertex3f(dx + current_radius * math.cos(t1), dy + 0.02, dz + current_radius * math.sin(t1))
            glVertex3f(dx + current_radius * math.cos(t2), dy + 0.02, dz + current_radius * math.sin(t2))
        glEnd()

        # 2. Glowing Red Core Particles
        glPointSize(6.0)
        glBegin(GL_POINTS)
        for h_step in range(6):
            py = dy + h_step * 0.35
            pr = current_radius * (1.0 - h_step * 0.15)
            for j in range(4):
                ang = j * (math.pi / 2.0) + progress * 2.0
                glVertex3f(dx + pr * 0.4 * math.cos(ang), py, dz + pr * 0.4 * math.sin(ang))
        glEnd()

        # 3. Inner Red Core Glow Box
        glPushMatrix()
        glTranslatef(dx, dy + 0.6, dz)
        core_scale = max(0.1, 0.6 * (1.0 - progress))
        draw_box(core_scale, core_scale * 1.5, core_scale, color_top=(1.0, 0.2, 0.2), color_side=(0.8, 0.1, 0.1))
        glPopMatrix()

