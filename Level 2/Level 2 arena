def keyboard_listener(key, x, y):
    """
    Handles standard ASCII keys: WASD, Space, C, F, V, P, R, ESC.
    """
    global player_pos, crouching, is_jumping, y_velocity
    global first_person, is_paused, is_game_over

    try:
        ch = key.decode('utf-8').lower()
    except:
        ch = str(key).lower()

    rad = math.radians(player_yaw)

    if not is_paused and not is_game_over and not is_level_cleared:
        # Move Forward (W)
        if ch == 'w':
            player_pos[0] += math.sin(rad) * player_speed
            player_pos[2] += math.cos(rad) * player_speed
        # Move Backward (S)
        elif ch == 's':
            player_pos[0] -= math.sin(rad) * player_speed
            player_pos[2] -= math.cos(rad) * player_speed
        # Strafe Left (A)
        elif ch == 'a':
            player_pos[0] += math.sin(rad + math.pi / 2.0) * player_speed
            player_pos[2] += math.cos(rad + math.pi / 2.0) * player_speed
        # Strafe Right (D)
        elif ch == 'd':
            player_pos[0] += math.sin(rad - math.pi / 2.0) * player_speed
            player_pos[2] += math.cos(rad - math.pi / 2.0) * player_speed
        # Crouch (C)
        elif ch == 'c':
            crouching = not crouching
        # Jump (Spacebar)
        elif ch == ' ' or key == b' ':
            if not is_jumping:
                is_jumping = True
                y_velocity = jump_strength
        # Manual Shoot (F)
        elif ch == 'f':
            shoot_bullet()
        # Toggle Camera View (V): 1st Person <-> 3rd Person Follow (identical to Right Click)
        elif ch == 'v':
            first_person = not first_person

    # Pause Toggle (P)
    if ch == 'p':
        is_paused = not is_paused

    # Reset Arena (R)
    elif ch == 'r':
        reset_arena()

    # ESC to Exit
    elif key == b'\x1b':
        try:
            glutLeaveMainLoop()
        except:
            sys.exit(0)

    # Restrict player within arena boundaries
    limit = ARENA_SIZE - 1.8
    player_pos[0] = max(-limit, min(limit, player_pos[0]))
    player_pos[2] = max(-limit, min(limit, player_pos[2]))

    glutPostRedisplay()

def special_key_listener(key, x, y):
    """
    Handles Arrow Keys (Left/Right to turn yaw, Up/Down to pitch camera).
    """
    global player_yaw, player_pitch

    if key == GLUT_KEY_LEFT:
        player_yaw = (player_yaw + 5.0) % 360.0
    elif key == GLUT_KEY_RIGHT:
        player_yaw = (player_yaw - 5.0) % 360.0
    elif key == GLUT_KEY_UP:
        player_pitch = min(60.0, player_pitch + 3.0)
    elif key == GLUT_KEY_DOWN:
        player_pitch = max(-45.0, player_pitch - 3.0)

    glutPostRedisplay()

def mouse_listener(button, state, x, y):
    """
    Handles mouse inputs: Left Click = Shoot Gun, Right Click = Toggle Camera View.
    """
    global first_person

    if state == GLUT_DOWN:
        if button == GLUT_LEFT_BUTTON:
            shoot_bullet()
        elif button == GLUT_RIGHT_BUTTON:
            first_person = not first_person
            glutPostRedisplay()

def reset_arena():
    """
    Resets the player, gun, zombies, and game stats to initial state.
    """
    global player_pos, player_yaw, player_pitch, player_lives
    global is_jumping, crouching, gun_picked_up
    global score, zombies_killed, zombies_spawned, bullets, zombies
    global is_game_over, is_level_cleared, is_paused, is_target_locked

    player_pos = [0.0, 1.0, -35.0]
    player_yaw = 0.0
    player_pitch = 0.0
    player_lives = 9
    is_jumping = False
    crouching = False

    gun_picked_up = False
    score = 0
    zombies_killed = 0
    zombies_spawned = 0
    bullets = []
    zombies = []
    is_game_over = False
    is_level_cleared = False
    is_paused = False
    is_target_locked = False

    # Spawn 2 initial zombies
    for _ in range(2):
        spawn_zombie()

    print(">> Level 2 Arena Reset! Pick up the gun and eliminate all 10 zombies.")

