def draw_arena_environment():
    """
    Draws the complete Level 2 Arena:
    - Large square dark floor with decorative grid lines
    - 4 perimeter walls in dark crimson obsidian with trims
    - 4 corner guard towers/pillars with glowing lamps
    - Overhead fluorescent light fixtures
    """
    # 1. Main Dark Floor
    glPushMatrix()
    glTranslatef(0.0, -0.1, 0.0)
    draw_box(ARENA_SIZE * 2.0, 0.2, ARENA_SIZE * 2.0, color_top=COLOR_FLOOR, color_side=(0.04, 0.04, 0.06))
    glPopMatrix()

    # Floor Grid Lines for visual depth
    glColor3f(*COLOR_FLOOR_GRID)
    glLineWidth(1.5)
    glBegin(GL_LINES)
    step = 10.0
    for grid_pos in range(int(-ARENA_SIZE), int(ARENA_SIZE) + 1, int(step)):
        glVertex3f(float(grid_pos), 0.01, -ARENA_SIZE)
        glVertex3f(float(grid_pos), 0.01, ARENA_SIZE)
        glVertex3f(-ARENA_SIZE, 0.01, float(grid_pos))
        glVertex3f(ARENA_SIZE, 0.01, float(grid_pos))
    glEnd()

    # Center Combat Ring Marking
    glColor3f(0.3, 0.2, 0.4)
    glLineWidth(2.5)
    glBegin(GL_LINES)
    segments = 36
    radius = 12.0
    for i in range(segments):
        theta1 = 2.0 * math.pi * i / segments
        theta2 = 2.0 * math.pi * (i + 1) / segments
        glVertex3f(radius * math.cos(theta1), 0.02, radius * math.sin(theta1))
        glVertex3f(radius * math.cos(theta2), 0.02, radius * math.sin(theta2))
    glEnd()

    # 2. Perimeter Walls (North, South, East, West)
    wall_thickness = 1.6
    half_size = ARENA_SIZE
    wall_y = WALL_HEIGHT / 2.0

    # North Wall (Z = +ARENA_SIZE)
    glPushMatrix()
    glTranslatef(0.0, wall_y, half_size + wall_thickness / 2.0)
    draw_box(half_size * 2.0 + wall_thickness * 2.0, WALL_HEIGHT, wall_thickness, color_top=COLOR_WALL, color_side=COLOR_WALL_SIDE)
    glPopMatrix()

    # South Wall (Z = -ARENA_SIZE)
    glPushMatrix()
    glTranslatef(0.0, wall_y, -half_size - wall_thickness / 2.0)
    draw_box(half_size * 2.0 + wall_thickness * 2.0, WALL_HEIGHT, wall_thickness, color_top=COLOR_WALL, color_side=COLOR_WALL_SIDE)
    glPopMatrix()

    # West Wall (X = -ARENA_SIZE)
    glPushMatrix()
    glTranslatef(-half_size - wall_thickness / 2.0, wall_y, 0.0)
    draw_box(wall_thickness, WALL_HEIGHT, half_size * 2.0, color_top=COLOR_WALL, color_side=COLOR_WALL_SIDE)
    glPopMatrix()

    # East Wall (X = +ARENA_SIZE)
    glPushMatrix()
    glTranslatef(half_size + wall_thickness / 2.0, wall_y, 0.0)
    draw_box(wall_thickness, WALL_HEIGHT, half_size * 2.0, color_top=COLOR_WALL, color_side=COLOR_WALL_SIDE)
    glPopMatrix()

    # Wall Trims (Glowing accent bars along top edges)
    trim_color = COLOR_WALL_TRIM
    for wx, wz, sx, sz in [
        (0.0, half_size, half_size * 2.0, 0.4),
        (0.0, -half_size, half_size * 2.0, 0.4),
        (-half_size, 0.0, 0.4, half_size * 2.0),
        (half_size, 0.0, 0.4, half_size * 2.0)
    ]:
        glPushMatrix()
        glTranslatef(wx, WALL_HEIGHT - 0.4, wz)
        draw_box(sx, 0.6, sz, color_top=trim_color, color_side=trim_color)
        glPopMatrix()

    # 3. Corner Pillars
    pillar_coords = [
        (-half_size, -half_size),
        (half_size, -half_size),
        (-half_size, half_size),
        (half_size, half_size)
    ]
    for px, pz in pillar_coords:
        glPushMatrix()
        glTranslatef(px, WALL_HEIGHT / 2.0, pz)
        draw_box(3.2, WALL_HEIGHT + 1.0, 3.2, color_top=COLOR_PILLAR, color_side=(0.10, 0.10, 0.12))
        glPopMatrix()

        glPushMatrix()
        glTranslatef(px, WALL_HEIGHT + 0.8, pz)
        draw_box(2.0, 0.6, 2.0, color_top=COLOR_PILLAR_GLOW, color_side=(0.7, 0.1, 0.1))
        glPopMatrix()

    # 4. Overhead Fluorescent Light Fixtures
    light_positions = [
        (-30.0, -30.0), (30.0, -30.0),
        (-30.0, 30.0), (30.0, 30.0),
        (0.0, -20.0), (0.0, 20.0)
    ]
    for lx, lz in light_positions:
        glPushMatrix()
        glTranslatef(lx, WALL_HEIGHT - 0.2, lz)
        draw_box(4.0, 0.15, 6.0, color_top=COLOR_LIGHT_PANEL, color_side=(0.6, 0.6, 0.4))
        glPopMatrix()

