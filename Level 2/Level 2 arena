# 3D Zombie Horde Model & Rendering (Extra Slow Shambling)
# -----------------------------------------------------------------------------
class Zombie:
    def __init__(self, x, z):
        self.pos = [x, 0.9, z]
        self.hp = 3
        self.max_hp = 3
        self.speed = zombie_base_speed + random.uniform(-0.004, 0.004)
        self.yaw = 0.0
        self.hit_timer = 0
        self.walk_anim = random.uniform(0, 10)

    def update(self):
        # Update hit flash timer
        if self.hit_timer > 0:
            self.hit_timer -= 1

        # Walk animation cycle
        self.walk_anim += 0.05

        # Move slowly towards player position
        dx = player_pos[0] - self.pos[0]
        dz = player_pos[2] - self.pos[2]
        dist = math.sqrt(dx * dx + dz * dz)

        if dist > 0.6:
            # Face player
            self.yaw = math.degrees(math.atan2(dx, dz))
            # Step forward slowly
            self.pos[0] += (dx / dist) * self.speed
            self.pos[2] += (dz / dist) * self.speed

        # Keep within arena boundaries
        limit = ARENA_SIZE - 2.0
        self.pos[0] = max(-limit, min(limit, self.pos[0]))
        self.pos[2] = max(-limit, min(limit, self.pos[2]))

    def draw(self):
        glPushMatrix()
        glTranslatef(self.pos[0], self.pos[1], self.pos[2])
        glRotatef(self.yaw, 0, 1, 0)

        # Hit flash color
        if self.hit_timer > 0:
            skin_color = (1.0, 1.0, 1.0)  # Flash white on hit
        else:
            skin_color = c_zombie_skin

        # 1. Zombie Torso
        glPushMatrix()
        glTranslatef(0.0, 1.0, 0.0)
