def spawn_zombie():
    """
    Spawns a zombie at a random perimeter edge if the total limit of 10 hasn't been reached.
    """
    global zombies_spawned

    if zombies_spawned >= TOTAL_ZOMBIES_COUNT:
        return
    if len(zombies) >= MAX_ACTIVE_ZOMBIES:
        return

    side = random.randint(0, 3)
    spawn_offset = ARENA_SIZE - 4.0
    if side == 0:  # North
        x = random.uniform(-spawn_offset, spawn_offset)
        z = spawn_offset
    elif side == 1:  # South
        x = random.uniform(-spawn_offset, spawn_offset)
        z = -spawn_offset
    elif side == 2:  # West
        x = -spawn_offset
        z = random.uniform(-spawn_offset, spawn_offset)
    else:  # East
        x = spawn_offset
        z = random.uniform(-spawn_offset, spawn_offset)

    zombies.append(Zombie(x, z))
    zombies_spawned += 1

# -----------------------------------------------------------------------------
# Bullets & Auto-Target Shooting Mechanics (Unlimited Ammo)
# -----------------------------------------------------------------------------
def check_auto_target_and_shoot():
    """
    Calculates if the player's view vector is directly pointed at any active zombie.
    If aiming at a zombie and the gun is equipped, fires automatically with unlimited ammo!
    """
    global is_target_locked

    if not gun_picked_up or is_paused or is_game_over or is_level_cleared:
        is_target_locked = False
        return

    rad_yaw = math.radians(player_yaw)
    rad_pitch = math.radians(player_pitch)

    # Player look direction unit vector
    dir_x = math.sin(rad_yaw) * math.cos(rad_pitch)
    dir_y = math.sin(rad_pitch)
    dir_z = math.cos(rad_yaw) * math.cos(rad_pitch)

    eye_y = player_pos[1] + (0.8 if crouching else eye_height)

    locked = False
    for z in zombies:
        vx = z.pos[0] - player_pos[0]
        vy = (z.pos[1] + 1.2) - eye_y
        vz = z.pos[2] - player_pos[2]
        dist = math.sqrt(vx * vx + vy * vy + vz * vz)

        if dist > 0.5 and dist < 80.0:
            ux, uy, uz = vx / dist, vy / dist, vz / dist
            dot = dir_x * ux + dir_y * uy + dir_z * uz

            # Threshold for aiming directly at zombie (~18 degree cone)
            if dot > 0.94:
                locked = True
                if fire_cooldown <= 0:
                    shoot_bullet()
                break

    is_target_locked = locked

def shoot_bullet():
    """
    Fires a high-velocity laser bullet in the player's aiming direction (Unlimited Ammo).
    """
    global fire_cooldown

    if not gun_picked_up:
        return
    if fire_cooldown > 0:
        return

    fire_cooldown = 9  # Cooldown between shots

    rad_yaw = math.radians(player_yaw)
    rad_pitch = math.radians(player_pitch)

    vx = math.sin(rad_yaw) * math.cos(rad_pitch) * BULLET_SPEED
    vy = math.sin(rad_pitch) * BULLET_SPEED
    vz = math.cos(rad_yaw) * math.cos(rad_pitch) * BULLET_SPEED

    start_x = player_pos[0] + math.sin(rad_yaw) * 0.8
    start_y = player_pos[1] + (0.8 if crouching else 1.4)
    start_z = player_pos[2] + math.cos(rad_yaw) * 0.8

    bullets.append({
        'pos': [start_x, start_y, start_z],
        'vel': [vx, vy, vz],
        'life': BULLET_MAX_LIFE
    })

def update_bullets():
    """
    Updates bullet positions and performs collision checks against zombies & boundaries.
    """
    global score, zombies_killed, is_level_cleared

    for b in bullets[:]:
        b['pos'][0] += b['vel'][0]
        b['pos'][1] += b['vel'][1]
        b['pos'][2] += b['vel'][2]
        b['life'] -= 1

        bx, by, bz = b['pos']
        # Arena bounds check
        if abs(bx) >= ARENA_SIZE or abs(bz) >= ARENA_SIZE or by <= 0.0 or by >= WALL_HEIGHT:
            if b in bullets:
                bullets.remove(b)
            continue

        # Zombie collision
        hit_zombie = False
        for z in zombies[:]:
            dist_sq = (bx - z.pos[0])**2 + (by - (z.pos[1] + 1.0))**2 + (bz - z.pos[2])**2
            if dist_sq < 1.4:
                z.hp -= 1
                z.hit_timer = 6
                hit_zombie = True

                if z.hp <= 0:
                    zombies.remove(z)
                    score += 100
                    zombies_killed += 1

                    # Check stage victory
                    if zombies_killed >= TOTAL_ZOMBIES_COUNT:
                        is_level_cleared = True
                        print(">> STAGE CLEARED! All 10 Zombies eliminated!")

                if b in bullets:
                    bullets.remove(b)
                break

        if not hit_zombie and b['life'] <= 0:
            if b in bullets:
                bullets.remove(b)

def draw_bullets():
    """
    Renders active laser bullets in 3D using GL_LINES and glowing points.
    """
    for b in bullets:
        bx, by, bz = b['pos']
        vx, vy, vz = b['vel']

        glColor3f(*COLOR_BULLET)
        glLineWidth(4.0)
        glBegin(GL_LINES)
        glVertex3f(bx, by, bz)
        glVertex3f(bx - vx * 0.6, by - vy * 0.6, bz - vz * 0.6)
        glEnd()

        glColor3f(1.0, 1.0, 1.0)
        glPointSize(6.0)
        glBegin(GL_POINTS)
        glVertex3f(bx, by, bz)
        glEnd()

# -----------------------------------------------------------------------------
# Camera Setup (1st Person POV & 3rd Person Follow only)
# -----------------------------------------------------------------------------
def setup_camera():
    """
    Configures perspective projection and positions camera in 1st Person or 3rd Person Follow mode.
    """
    glMatrixMode(GL_PROJECTION)
    glLoadIdentity()
    gluPerspective(65.0, float(WINDOW_WIDTH) / float(WINDOW_HEIGHT), 0.1, 300.0)

    glMatrixMode(GL_MODELVIEW)
    glLoadIdentity()

    rad_yaw = math.radians(player_yaw)
    rad_pitch = math.radians(player_pitch)
    curr_eye_h = 0.8 if crouching else eye_height

    if first_person:  # 1st Person POV
        cam_x = player_pos[0]
        cam_y = player_pos[1] + curr_eye_h
        cam_z = player_pos[2]

        target_x = cam_x + math.sin(rad_yaw) * math.cos(rad_pitch)
        target_y = cam_y + math.sin(rad_pitch)
        target_z = cam_z + math.cos(rad_yaw) * math.cos(rad_pitch)

        gluLookAt(cam_x, cam_y, cam_z,
                  target_x, target_y, target_z,
                  0.0, 1.0, 0.0)

    else:  # 3rd Person Follow
        cam_x = player_pos[0] - math.sin(rad_yaw) * cam_dist
        cam_y = player_pos[1] + cam_height
        cam_z = player_pos[2] - math.cos(rad_yaw) * cam_dist

        target_x = player_pos[0]
        target_y = player_pos[1] + curr_eye_h
        target_z = player_pos[2]

        gluLookAt(cam_x, cam_y, cam_z,
                  target_x, target_y, target_z,
                  0.0, 1.0, 0.0)

