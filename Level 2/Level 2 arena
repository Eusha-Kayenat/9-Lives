def idle():
    """
    Main Animation & Physics loop called continuously by GLUT.
    """
    global player_pos, is_jumping, y_velocity, gun_rotation_angle
    global gun_picked_up, fire_cooldown, zombie_spawn_timer
    global player_lives, player_invulnerable_timer, is_game_over

    if is_paused or is_game_over or is_level_cleared:
        glutPostRedisplay()
        return

    # 1. Update Gun Rotation on Pedestal
    gun_rotation_angle = (gun_rotation_angle + 2.5) % 360.0

    # 2. Check Gun Pickup Collision
    if not gun_picked_up:
        dist_to_gun = math.sqrt((player_pos[0] - gun_pickup_pos[0])**2 + (player_pos[2] - gun_pickup_pos[2])**2)
        if dist_to_gun < 2.2:
            gun_picked_up = True
            print(">> Blaster Gun Acquired (UNLIMITED AMMO)! Look at any zombie to Auto-Shoot!")

    # 3. Update Player Jumping Physics (Matching Level 1)
    if is_jumping:
        player_pos[1] += y_velocity
        y_velocity += gravity
        if player_pos[1] <= ground_y:
            player_pos[1] = ground_y
            is_jumping = False
            y_velocity = 0.0

    # 4. Update Weapon Cooldown
    if fire_cooldown > 0:
        fire_cooldown -= 1

    # 5. Check Auto-Aim / Look-at Shooting
    check_auto_target_and_shoot()

    # 6. Update Bullets
    update_bullets()

    # 7. Zombie Spawning System (Max 10 total)
    if zombies_spawned < TOTAL_ZOMBIES_COUNT:
        zombie_spawn_timer += 1
        if zombie_spawn_timer >= ZOMBIE_SPAWN_INTERVAL:
            zombie_spawn_timer = 0
            spawn_zombie()

    # 8. Update Zombies & Player Hit Detection
    if player_invulnerable_timer > 0:
        player_invulnerable_timer -= 1

    for z in zombies:
        z.update()
        # Check collision with player
        dist_to_player = math.sqrt((z.pos[0] - player_pos[0])**2 + (z.pos[2] - player_pos[2])**2)
        if dist_to_player < 1.5 and player_invulnerable_timer <= 0:
            player_lives -= 1
            player_invulnerable_timer = 60  # ~1 second invulnerability
            print(f">> Player hit by Zombie! Lives remaining: {player_lives}")
            if player_lives <= 0:
                is_game_over = True
                print(">> All 9 Lives lost! Press R to Restart.")

    glutPostRedisplay()

