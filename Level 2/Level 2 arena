# Crate Decorations (Solid Wooden Obstacles)
# -----------------------------------------------------------------------------
def draw_single_crate(x, y, z, size=2.5, angle_y=0.0):
    """
    Renders an individual 3D wooden crate with planks and diagonal cross reinforcement.
    """
    glPushMatrix()
    glTranslatef(x, y + size / 2.0, z)
    if angle_y != 0.0:
        glRotatef(angle_y, 0, 1, 0)

    # 1. Main Wooden Box Body
    draw_box(size, size, size, color_top=COLOR_CRATE_WOOD, color_side=COLOR_CRATE_WOOD)

    # 2. Dark Wood Border Trims
    trim_h = size * 0.08
    draw_box(size * 1.02, trim_h, size * 1.02, color_top=COLOR_CRATE_TRIM, color_side=COLOR_CRATE_TRIM)

    # 3. Diagonal Support Crossbars on Faces
    glColor3f(*COLOR_CRATE_TRIM)
    glLineWidth(2.0)
    hs = (size / 2.0) * 1.01
    glBegin(GL_LINES)
    # Front Face
    glVertex3f(-hs, -hs, hs); glVertex3f(hs, hs, hs)
    glVertex3f(hs, -hs, hs); glVertex3f(-hs, hs, hs)
    # Back Face
    glVertex3f(-hs, -hs, -hs); glVertex3f(hs, hs, -hs)
    glVertex3f(hs, -hs, -hs); glVertex3f(-hs, hs, -hs)
    # Left Face
    glVertex3f(-hs, -hs, -hs); glVertex3f(-hs, hs, hs)
    glVertex3f(-hs, -hs, hs); glVertex3f(-hs, hs, -hs)
    # Right Face
    glVertex3f(hs, -hs, -hs); glVertex3f(hs, hs, hs)
    glVertex3f(hs, -hs, hs); glVertex3f(hs, hs, -hs)
    glEnd()

    glPopMatrix()

def draw_crate_piles():
    """
    Renders all 3D crates in the arena from the pre-calculated crate dataset.
    """
    for c in CRATE_BOXES:
        draw_single_crate(c["cx"], c["min_y"], c["cz"], c["size"], c["angle"])

