def reset_arena():
    """
    Resets the player, gun, catnip, zombies, and game stats to initial state.
    """
    global player_pos, player_yaw, player_pitch, player_hp
    global is_jumping, crouching, gun_picked_up, catnip_spawned, catnip_picked_up, active_weapon
    global score, zombies_killed, zombies_spawned, grenades, death_effects, zombies
    global is_game_over, is_level_cleared, is_paused, is_target_locked, mouse_down

    player_pos = [0.0, 1.0, -35.0]
