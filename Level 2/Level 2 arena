def draw_arena_environment():
    """
    Draws the Level 2 Arena:
    - Clean solid dark floor (No grids)
    - 4 perimeter walls in dark crimson obsidian with top trims (No roof lights)
    - 4 corner guard pillars with glowing torch beacons
    - Solid brown wooden crate piles
    """
    # 1. Clean Solid Dark Floor
    glPushMatrix()
    glTranslatef(0.0, -0.1, 0.0)
    draw_box(ARENA_SIZE * 2.0, 0.2, ARENA_SIZE * 2.0, color_top=COLOR_FLOOR, color_side=COLOR_FLOOR_SIDE)
    glPopMatrix()

    # 2. Perimeter Walls (North, South, East, West)
    wall_thickness = 1.6
    half_size = ARENA_SIZE
    wall_y = WALL_HEIGHT / 2.0

    # North Wall (Z = +ARENA_SIZE)
    glPushMatrix()
    glTranslatef(0.0, wall_y, half_size + wall_thickness / 2.0)
    draw_box(half_size * 2.0 + wall_thickness * 2.0, WALL_HEIGHT, wall_thickness, color_top=COLOR_WALL, color_side=COLOR_WALL_SIDE)
    glPopMatrix()

    # South Wall (Z = -ARENA_SIZE)
    glPushMatrix()
    glTranslatef(0.0, wall_y, -half_size - wall_thickness / 2.0)
    draw_box(half_size * 2.0 + wall_thickness * 2.0, WALL_HEIGHT, wall_thickness, color_top=COLOR_WALL, color_side=COLOR_WALL_SIDE)
    glPopMatrix()

