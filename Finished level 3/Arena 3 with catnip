            continue
        glPushMatrix()
        glTranslatef(exp.x, exp.y, exp.z)
        alpha = exp.life / float(exp.max_life)
        if exp.is_blue:
            glColor3f(0.1 * alpha, 0.85 * alpha, 1.0 * alpha)
