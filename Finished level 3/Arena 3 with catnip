            glColor3f(1.0 * alpha, 0.45 * alpha, 0.05 * alpha)
        gluSphere(Q(), exp.radius, 10, 10)
        glPointSize(4)
        glBegin(GL_POINTS)
        for p in exp.particles:
            if exp.is_blue:
                glColor3f(0.4 * alpha, 0.95 * alpha, 1.0 * alpha)
